<?xml version="1.0" encoding="UTF-8"?>
<!--
  poc-vue: Aday 1 - Spring Boot REST + Vue 3 (derleme adımsız; Vue tek dosyada, CDN'den yüklenir).
  Amaç: durumsuz mimarinin bellek/hız davranışını ve "düzeni JSON'dan çiz" kolaylığını görmek.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.burevers</groupId>
        <artifactId>burever-poc</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>burever-poc-vue</artifactId>
    <name>Burever - Kanıt: Vue</name>
    <dependencies>
        <dependency>
            <groupId>com.burevers</groupId>
            <artifactId>burever-tem</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
