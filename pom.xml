<?xml version="1.0" encoding="UTF-8"?>
<!--
  Burevers - Kök (parent) POM

  Görevi:
   - Tüm Maven modüllerinin ortak sürüm, bağımlılık ve eklenti ayarlarını tek yerden yönetir (ADR-02).
   - Proje sürümü yalnızca burada, ${revision} özelliğinde tutulur (CI dostu sürümleme, ADR-18).
   - Spring Boot'un parent'ını kullanır: eklenti sürümleri ve varsayılan derleme ayarları buradan gelir.

  Modül ekleme kuralı: bel, muh, mht modülleri, ilgili aşama gelince bu listeye eklenir.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- Parent'ı yerel dosyadan değil, depodan çöz -->
    </parent>

    <groupId>com.burevers</groupId>
    <artifactId>burever</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>Burever</name>
    <description>Çok modüllü, modüler monolit ERP</description>

    <modules>
        <!-- Çekirdek: saf Java (Money vb.), hiçbir çatıya bağımlı değil -->
        <module>cekirdek</module>
        <!-- tem: temel tanımlar (organizasyon, kuruluş, tesis, kullanıcı, menü, yetki...) -->
        <module>tem</module>
        <!-- uygulama: tüm modülleri birleştiren çalıştırılabilir Spring Boot uygulaması -->
        <module>uygulama</module>
        <!-- Mimari kuralların testi (ArchUnit) -->
        <module>testler/mimari-testler</module>
    </modules>

    <properties>
        <!-- Tek sürüm kaynağı: tüm modüller bu sürümü kullanır -->
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>25</java.version>

        <!-- Sürümler Spring Initializr çıktısından alındı; gerçek derleme doğrulaması bekliyor -->
        <vaadin.version>25.3.1</vaadin.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Vaadin bileşen sürümlerini tek BOM'dan yönet -->
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Modulith sürümleri (starter, ilk paketler açılınca eklenecek) -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Kendi modüllerimiz: sürüm ${project.version} ile eşitlenir -->
            <dependency>
                <groupId>com.burevers</groupId>
                <artifactId>burever-cekirdek</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.burevers</groupId>
                <artifactId>burever-tem</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.burevers</groupId>
                <artifactId>burever-uygulama</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- ArchUnit çekirdeği: JUnit sürümünden bağımsız çalışır -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Yanlış Java/Maven sürümüyle derlemeyi baştan durdurur -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>ortam-kurallari</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>Bu proje Java 25 veya üzeri gerektirir.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                    <message>Bu proje Maven 3.9 veya üzeri gerektirir.</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
